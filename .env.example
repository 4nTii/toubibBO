# =============================================================
# ToubibBO (doctor back-office) — Environment variables template
# Copy this file to .env and fill in your values
#   cp .env.example .env
#
# Dev overrides live in .env.dev (versioned, loaded on top in dev mode)
# =============================================================

# Docker — port exposed by the production container (docker-compose.prod.yml)
FRONT_PORT=80

# API base URL (no trailing slash)
# Dev  → https://localhost:8000/api  (or your local IP: https://192.168.x.x:8000/api)
# Prod → https://your-domain.com/api
VITE_API_URL=https://localhost:8000/api

# Application
VITE_APP_NAME=Toubib
VITE_MESSAGE_TIMEOUT=3000
VITE_CURRENCY_SYMBOL=€

# Base URL for user-uploaded files served from the FTP server
# Must match FTP_BASE_DIR exposed via HTTP on the API server
VITE_FTP_TARGET=https://toubib.byethost24.com/files/
