# ================================
# ENVIRONMENT VARIABLES TEMPLATE
# ================================
# Copy this file to .env and fill in your values
# For development, copy to .env.dev

# API Configuration
# The base URL for your backend API
VITE_API_URL=https://localhost:8000/api

# Application Configuration
# The name displayed in the app
VITE_APP_NAME=Toubib

# UI Configuration
# Timeout in milliseconds for dismissing messages
VITE_MESSAGE_TIMEOUT=3000
VITE_CURRENCY_SYMBOL=€

# FTP
VITE_FTP_TARGET=https://toubib.byethost24.com/files/